# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) — migrations require a session connection.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- OpenAI / Groq (needed once the LLM / embedding layer is wired up) ---
# Uses OpenAI SDK pointed at an OpenAI-compatible endpoint (Groq, OpenAI, etc.).
# For Groq: set OPENAI_BASE_URL=https://api.groq.com/openai/v1 and a gsk_* key.
# For OpenAI: set OPENAI_BASE_URL=https://api.openai.com/v1 and an sk-* key.

OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# NOTE: Groq does not currently support embedding models. When Phase 4 (ingestion)
# needs embeddings, either switch to an OpenAI key or use a separate embedding provider.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173
